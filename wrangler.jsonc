{
  // Cloudflare Worker with static assets (deployed by Workers Builds on push to main).
  "name": "polished-disk-ce44",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // Serve 404.html (with a 404 status) for URLs that match no file.
    "not_found_handling": "404-page"
  }
}
